# Copy to .env (same folder as compose.yaml), fill in, then: docker compose up -d
# .env is git-ignored. Never commit the real values.

# Google Cloud Console > Google Auth Platform > Clients > the "Door Control" web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave empty: no domain-wide access (1.2.0). If set, every verified account on that Google
# Workspace domain could sign in.
GOOGLE_ALLOWED_DOMAINS=
# The admins, comma-separated, for example:
#   GOOGLE_ALLOWED_EMAILS=admin1@hardincountyfair.org,admin2@hardincountyfair.org
# Admins sign in with Google and manage Settings > People in the app (everyone else who may
# sign in). Admins can only be removed here (then restart). Empty: nobody signs in with Google
# unless the People list has someone; the break-glass password still works.
GOOGLE_ALLOWED_EMAILS=

# The internet address (Cloudflare tunnel). Google sign-in and the admin password work only here.
PUBLIC_HOSTS=doors.jakemc.me
# Host names accepted for direct requests (not through Cloudflare). The port is published on
# 127.0.0.1 only, so in practice this is fair-server itself; the LAN entries only matter if the
# port is ever published on the fair network again. Empty means every other address is refused.
ALLOWED_HOSTS=192.168.1.160:8480,fair-server:8480,localhost:8480,127.0.0.1:8480

# The only peer allowed to vouch for Cloudflare traffic (CF-Connecting-IP and the PUBLIC_HOSTS
# name): the gateway of this app's own network door-control-net (compose.yaml), where
# cloudflared on fair-server appears. Other containers are not trusted. If this is wrong,
# sign-in at PUBLIC_HOSTS is refused (403); it never opens the app. See README "Trusted proxies".
TRUSTED_PROXIES=172.31.248.1/32

# Optional, rarely needed (defaults shown; compose.yaml and the image already set them):
# PORT=8480
# BIND=0.0.0.0
# DATA_DIR=/data
# DOORCONTROL_CONFIG=/data/config.json
